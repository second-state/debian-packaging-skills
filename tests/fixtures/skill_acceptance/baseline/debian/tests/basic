#!/usr/bin/env python3
"""Baseline consumer uses the old positional interface."""
import subprocess
import sys

result = subprocess.run([sys.executable, "src/greet.py", "Debian"], capture_output=True, text=True)
assert result.returncode == 0, result.stderr
assert result.stdout == "Hello, Debian!\n", result.stdout
print("baseline positional greeting: OK")
