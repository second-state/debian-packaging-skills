#!/usr/bin/env python3
"""Exercise the fixture's public CLI, including a rejected old invocation."""
import os
import subprocess
import sys

app = os.environ.get("FIXTURE_APP", "src/greet.py")

def run(*args):
    return subprocess.run([sys.executable, app, *args], capture_output=True, text=True)

result = run("--name", "Debian")
assert result.returncode == 0, result.stderr
assert result.stdout == "Hello, Debian!\n", result.stdout
print("named greeting: OK")
result = run("--version")
assert result.returncode == 0 and result.stdout == "1.1\n", (result.returncode, result.stdout)
print("version 1.1: OK")
result = run("Debian")
assert result.returncode == 2 and "--name" in result.stderr, (result.returncode, result.stderr)
print("old positional invocation rejected: OK")
